function calcularBateriaFinal(eventos) {
    let bateria = 50; // carga inicial da bateria

    for (let i = 0; i < eventos.length; i++) {
        let evento = eventos[i];

        if (evento > 0) {
            // Evento positivo: carregando
            bateria += evento;
            if (bateria > 100) {
                bateria = 100; // Não ultrapassa 100%
            }
        } else {
            // Evento negativo: jogando
            bateria += evento; // evento já é negativo
            if (bateria < 0) {
                bateria = 0; // Não pode ser menor que 0%
            }
        }
    }

    return bateria; // Retorna a carga final
}

// Exemplo de uso:
const eventos = [30, -20, -10, 15, -2];
const cargaFinal = calcularBateriaFinal(eventos);

console.log(`Bateria final: ${cargaFinal}%`);
